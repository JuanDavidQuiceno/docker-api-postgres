# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube al repositorio.

# API
PORT=3000
HOST=0.0.0.0

# Base de datos
# En Docker, docker-compose fija HOST_DB=db y PORT_DB=3306 (nombre del servicio en la red).
# En local (npm run start:local), se usan estos valores.
PORT_DB=3306
HOST_DB=127.0.0.1
DB=notes_db
USER_DB=notes_user
PASS_DB=cambia_esta_contrasena

# Solo para el contenedor MySQL
MYSQL_ROOT_PASSWORD=cambia_esta_contrasena_root
